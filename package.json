{
	"name": "@maklja/vision-simulator",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24.19.0 <25",
		"pnpm": "12.6.0"
	},
	"scripts": {
		"start": "pnpm --filter @maklja/vision-simulator-viewer start",
		"build": "pnpm --filter @maklja/vision-simulator-viewer build",
		"lint": "pnpm -r --if-present run eslint",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "1.43.1",
		"@vitest/coverage-v8": "1.6.0",
		"fake-indexeddb": "5.0.2",
		"jsdom": "24.0.0",
		"typescript": "4.8.4",
		"vitest": "1.6.0"
	}
}
