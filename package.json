{
	"name": "@maklja/vision-simulator",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24.19.0 <25",
		"pnpm": "12.6.0"
	},
	"scripts": {
		"start": "pnpm --filter @maklja/vision-simulator-viewer start",
		"build": "pnpm --filter @maklja/vision-simulator-viewer build",
		"format:check": "prettier --check .github/workflows/ci.yml .prettierrc AGENTS.md README.md eslint.config.mjs package.json packages/*/package.json tsconfig*.json packages/simulator-viewer/tsconfig.json vitest.config.mts",
		"lint": "eslint packages",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "24.19.0",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"@vitest/coverage-v8": "5.0.2",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"fake-indexeddb": "6.2.5",
		"jsdom": "30.1.1",
		"prettier": "3.9.9",
		"typescript": "6.0.3",
		"vitest": "5.0.2"
	}
}
