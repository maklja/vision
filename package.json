{
	"name": "@maklja/vision-simulator",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24.19.0 <25",
		"pnpm": "12.6.0"
	},
	"scripts": {
		"start": "pnpm --filter @maklja/vision-simulator-viewer start",
		"build": "pnpm --filter @maklja/vision-simulator-viewer build",
		"audit:dependencies": "pnpm run audit:vulnerabilities && pnpm run audit:licenses",
		"audit:vulnerabilities": "pnpm audit --audit-level high",
		"audit:licenses": "node scripts/check-licenses.mjs",
		"format:check": "prettier --check .",
		"lint": "eslint packages",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@playwright/test": "1.63.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.0",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"@vitest/coverage-v8": "5.0.2",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-react": "7.37.5",
		"fake-indexeddb": "6.2.5",
		"jsdom": "30.1.1",
		"prettier": "3.9.9",
		"spdx-expression-parse": "5.0.0",
		"typescript": "6.0.3",
		"vitest": "5.0.2"
	}
}
