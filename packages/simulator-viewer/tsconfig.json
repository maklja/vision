{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"useDefineForClassFields": true,
		"jsx": "react-jsx",
		// Playwright resolves imports in these sources with this tsconfig, so map the
		// workspace packages to their TypeScript sources here as well.
		"baseUrl": ".",
		"paths": {
			"@maklja/vision-simulator-model": ["../simulator-model/src/index.ts"],
			"@maklja/vision-simulator-engine": ["../simulator-engine/src/index.ts"]
		}
	},
	"include": ["src"]
}
